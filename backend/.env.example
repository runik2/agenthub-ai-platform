# Copy to backend/.env and adjust. Local mode needs nothing else installed.

# local | docker
APP_MODE=local

# local: SQLite file. docker: postgresql+asyncpg://agenthub:agenthub@db:5432/agenthub
DATABASE_URL=sqlite+aiosqlite:///./data/agenthub.db

# Change both for anything beyond a local demo.
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=720
REFRESH_TOKEN_TTL_DAYS=30
# Optional: base64 encoded 32-byte key. When empty a Fernet key is derived from JWT_SECRET.
SECRET_ENCRYPTION_KEY=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_TIMEOUT_SECONDS=120

BOOTSTRAP_ADMIN_EMAIL=admin@agenthub.local
BOOTSTRAP_ADMIN_PASSWORD=admin12345
BOOTSTRAP_ADMIN_NAME=AgentHub Admin

SEED_DEMO_DATA=true
LOG_LEVEL=INFO
